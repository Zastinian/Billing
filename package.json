{
  "name": "billing",
  "type": "module",
  "version": "develop",
  "scripts": {
    "dev": "astro dev",
    "start": "bun run server.ts",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check --minimumSeverity --minimumFailingSeverity && tsc --noEmit && biome ci ./src --organize-imports-enabled=false",
    "lint": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "prepare:husky": "husky",
    "db:create": "bunx --bun typeorm migration:create src/database/migrations/<name>",
    "db:entity": "bunx --bun typeorm entity:create src/database/entities/<name>",
    "db:migrate": "bunx --bun typeorm migration:run --dataSource src/database/data-source.ts",
    "key:generate": "bun --bun run ./src/scripts/key.ts"
  },
  "dependencies": {
    "@hedystia/astro-bun": "^0.3.1",
    "astro": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "~6.15.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.14.0",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^1.9.4",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "husky": "^9.1.7",
    "typescript": "^5.8.3"
  }
}
