{
  "name": "billing",
  "type": "module",
  "version": "v2.0.0-beta.1",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "start": "bun --bun run server.ts",
    "build": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "check": "astro check --minimumSeverity --minimumFailingSeverity && tsc --noEmit && biome ci ./src --organize-imports-enabled=false",
    "lint": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "prepare:husky": "husky",
    "db:create": "bunx --bun typeorm migration:create src/database/migrations/<name>",
    "db:entity": "bunx --bun typeorm entity:create src/database/entities/<name>",
    "db:migrate": "bunx --bun typeorm migration:run --dataSource src/database/data-source.ts",
    "key:generate": "bun --bun run ./src/scripts/key.ts"
  },
  "dependencies": {
    "@hedystia/astro-bun": "0.3.2",
    "astro": "5.13.7",
    "jsonwebtoken": "9.0.2",
    "mongodb": "6.17.0",
    "mssql": "11.0.1",
    "mysql2": "3.14.1",
    "pg": "8.16.0",
    "reflect-metadata": "0.2.2",
    "sqlite3": "5.1.7",
    "typeorm": "0.3.26"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@biomejs/biome": "2.2.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.0.1",
    "husky": "9.1.7",
    "typescript": "5.9.2"
  }
}
