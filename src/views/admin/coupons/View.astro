---
import type { Coupons } from "@/database/entities/Coupons";

interface Props {
    coupon: Coupons;
}

const { coupon } = Astro.props;
---

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <form
                action="/api/admin/coupon/create"
                method="POST"
                data-callback="createForm"
            >
                <div class="card-body row">
                    <div class="form-group col-lg-4">
                        <label for="codeInput">Coupon Code</label>
                        <input
                            type="text"
                            name="code"
                            class="form-control"
                            id="codeInput"
                            placeholder="Coupon Code"
                            required
                            value={coupon.code}
                        />
                    </div>
                    <div class="form-group col-lg-4">
                        <label for="percentOffInput">Percent Off</label>
                        <input
                            type="number"
                            name="percent_off"
                            min="1"
                            max="100"
                            step="1"
                            class="form-control"
                            id="percentOffInput"
                            placeholder="Percent Off"
                            required
                            value={coupon.percentOff}
                        />
                    </div>
                    <div class="form-group col-lg-4">
                        <label for="onetimeInput"
                            >One-time (first cycle only)?</label
                        >
                        <select class="form-control" name="one_time">
                            <option value="1" selected={coupon.oneTime === 1}
                                >Yes</option
                            >
                            <option value="0" selected={coupon.oneTime === 0}
                                >No</option
                            >
                        </select>
                    </div>
                    <div class="form-group col-lg-4">
                        <label for="globalLimitInput"
                            >Global Limit (max. uses) (Optional)</label
                        >
                        <input
                            type="number"
                            name="global_limit"
                            class="form-control"
                            id="globalLimitInput"
                            placeholder="0 = Cannot be used"
                            value={coupon.globalLimit}
                        />
                    </div>
                    <div class="form-group col-lg-4">
                        <label for="perClientInput"
                            >Per Client Limit (max. uses per client) (Optional)</label
                        >
                        <input
                            type="number"
                            name="per_client_limit"
                            class="form-control"
                            id="perClientInput"
                            placeholder="0 = Cannot be used"
                            value={coupon.perClientLimit}
                        />
                    </div>
                    <div class="form-group col-lg-4">
                        <label for="isGlobalInput"
                            >Global? (can be used in the whole store?)</label
                        >
                        <select class="form-control" name="is_global">
                            <option value="1" selected={coupon.isGlobal === 1}
                                >Yes</option
                            >
                            <option value="0" selected={coupon.isGlobal === 0}
                                >No</option
                            >
                        </select>
                    </div>
                    <div class="form-group col-lg-4">
                        <label for="endDateInput">End Date (Optional)</label>
                        <input
                            type="date"
                            name="end_date"
                            class="form-control"
                            id="endDateInput"
                            value={coupon.endDate
                                ? coupon.endDate.toISOString().split("T")[0]
                                : null}
                        />
                    </div>
                </div>
                <div class="card-footer row justify-content-center">
                    <button
                        type="submit"
                        form="updateForm"
                        class="btn btn-success btn-sm col-lg-2 col-3"
                        >Save</button
                    >
                    <button
                        type="submit"
                        form="deleteForm"
                        class="btn btn-danger btn-sm col-lg-2 col-3 offset-lg-1 offset-2"
                        >Delete</button
                    >
                </div>
            </form>
        </div>
    </div>
</div>
