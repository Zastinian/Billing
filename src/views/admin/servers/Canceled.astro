---
import { servers, plans, clients, settings } from "@/database/index";
import { serverStatus } from "@/utils/status";

const serversData = await servers.find({
  where: { status: serverStatus.canceled },
  order: { updatedAt: "DESC" },
});

const panelUrl = await settings.findOneBy({ key: "panel_url" }).then((setting) => setting?.value);
---

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body table-responsive">
                <table id="servers-table" class="table table-hover text-nowrap">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Panel ID</th>
                            <th>Client (Owner)</th>
                            <th>Plan</th>
                            <th>Cancellation Date</th>
                            <th>Creation Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            serversData.map(async (server) => {
                                const serverPlan = server.planId ? await plans.findOneBy({ id: server.planId }) : null;
                                const serverClient = server.clientId ? await clients.findOneBy({ id: server.clientId }) : null;
                                return (
                                    <tr>
                                        <td>{server.id}</td>
                                        <td>
                                            {server.serverId ? (
                                                <a href={new URL(`/admin/servers/view/${server.serverId}`, panelUrl ?? "").toString()} target="_blank">
                                                    {server.serverId}
                                                </a>
                                            ) : (
                                                "N/A"
                                            )}
                                        </td>
                                        <td>
                                            <a href={`/admin/clients/${server.clientId}`} target="_blank">
                                                {serverClient?.email || server.clientId}
                                            </a>
                                        </td>
                                        <td>
                                            {serverPlan ? (
                                                <a href={`/admin/plans/${server.planId}`} target="_blank">
                                                    {serverPlan.name}
                                                </a>
                                            ) : (
                                                "N/A"
                                            )}
                                        </td>
                                        <td>
                                            {server.updatedAt?.toLocaleDateString()} - {server.updatedAt?.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', hour12: false })}
                                        </td>
                                        <td>
                                            {server.createdAt?.toLocaleDateString()} - {server.createdAt?.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', hour12: false })}
                                        </td>
                                    </tr>
                                );
                            })
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>ID</th>
                            <th>Panel ID</th>
                            <th>Client (Owner)</th>
                            <th>Plan</th>
                            <th>Cancellation Date</th>
                            <th>Creation Date</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<script is:inline> lazyLoadCss('/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css'); </script>

<script src="/plugins/datatables/jquery.dataTables.min.js" is:inline></script>
<script src="/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js" is:inline></script>

<script is:inline>
    $(function () {
        $("#servers-table").DataTable({"responsive": false, "lengthChange": false, "autoWidth": false});
    });
</script>
