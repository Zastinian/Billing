---
import { invoices, clients, servers, currencies } from "@/database/index";
import { invoiceStatus } from "@/src/utils/status";
import convertCurrency from "@/utils/convertCurrency";
import type { Currencies } from "@/database/entities/Currencies";

const invoicesData = await invoices.find();

const unpaidInvoices = invoicesData.filter(
    (i) => i.paid === invoiceStatus.pending,
);
const paidInvoices = invoicesData.filter((i) => i.paid === invoiceStatus.paid);
---

<div class="row justify-content-center">
    <div class="card col-12">
        <div class="card-header">
            <h3 class="card-title">Unpaid Invoices</h3>
            <div class="card-tools">
                <button
                    type="button"
                    class="btn btn-tool"
                    data-card-widget="collapse"
                    ><i class="fas fa-minus"></i></button
                >
            </div>
        </div>
        <div class="card-body table-responsive">
            <table
                id="unpaid-invoice-table"
                class="table table-hover text-nowrap"
            >
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Item</th>
                        <th>Amount</th>
                        <th>Invoice Date</th>
                        <th>Due Date</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        await Promise.all(unpaidInvoices.map(async (i) => {
                            const client = await clients.findOneBy({ id: i.clientId });
                            const currency = client?.currency ? await currencies.findOneBy({ id: client.currency }) : null;
                            const defaultCurrency = await currencies.findOneBy({ id: 1 });
                            const formatPrice = (amount: number) => {
                                const converted = convertCurrency(amount, defaultCurrency as Currencies, currency as Currencies);
                                return `${currency?.symbol}${converted.toFixed(2)} ${currency?.name}`;
                            };
                            
                            return (
                                <tr>
                                    <td>
                                        <a href={`/admin/invoices/${i.id}`}>
                                            {i.id}
                                        </a>
                                    </td>
                                    <td>
                                        <a
                                            href={`/admin/clients/${i.clientId}`}
                                            target="_blank"
                                        >
                                            {client?.email || i.clientId}
                                        </a>
                                    </td>
                                    <td>
                                        {i.serverId ? (
                                            `Server #${i.serverId}`
                                        ) : i.credit ? (
                                            `${formatPrice(i.credit)} Credit`
                                        ) : "N/A"}
                                    </td>
                                    <td>{formatPrice(i.total)}</td>
                                    <td>
                                        {i.createdAt?.toLocaleDateString()} -{" "}
                                        {i.createdAt?.toLocaleTimeString(
                                            undefined,
                                            {
                                                hour: "2-digit",
                                                minute: "2-digit",
                                                hour12: false,
                                            },
                                        )}
                                    </td>
                                    <td>
                                        {i.dueDate?.toLocaleDateString()} -{" "}
                                        {i.dueDate?.toLocaleTimeString(
                                            undefined,
                                            {
                                                hour: "2-digit",
                                                minute: "2-digit",
                                                hour12: false,
                                            },
                                        )}
                                    </td>
                                </tr>
                            );
                        }))
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Item</th>
                        <th>Amount</th>
                        <th>Invoice Date</th>
                        <th>Due Date</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="card col-12">
        <div class="card-header">
            <h3 class="card-title">Paid Invoices</h3>
            <div class="card-tools">
                <button
                    type="button"
                    class="btn btn-tool"
                    data-card-widget="collapse"
                    ><i class="fas fa-minus"></i></button
                >
            </div>
        </div>
        <div class="card-body table-responsive">
            <table
                id="paid-invoice-table"
                class="table table-hover text-nowrap"
            >
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Item</th>
                        <th>Amount</th>
                        <th>Invoice Date</th>
                        <th>Paid Date</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        await Promise.all(paidInvoices.map(async (i) => {
                            const client = await clients.findOneBy({ id: i.clientId });
                            const currency = client?.currency ? await currencies.findOneBy({ id: client.currency }) : null;
                            const defaultCurrency = await currencies.findOneBy({ id: 1 });
                            const formatPrice = (amount: number) => {
                                const converted = convertCurrency(amount, defaultCurrency as Currencies, currency as Currencies);
                                return `${currency?.symbol}${converted.toFixed(2)} ${currency?.name}`;
                            };
                            
                            return (
                                <tr>
                                    <td>
                                        <a href={`/admin/invoices/${i.id}`}>
                                            {i.id}
                                        </a>
                                    </td>
                                    <td>
                                        <a
                                            href={`/admin/clients/${i.clientId}`}
                                            target="_blank"
                                        >
                                            {client?.email || i.clientId}
                                        </a>
                                    </td>
                                    <td>
                                        {i.serverId ? (
                                            `Server #${i.serverId}`
                                        ) : i.credit ? (
                                            `${formatPrice(i.credit)} Credit`
                                        ) : "N/A"}
                                    </td>
                                    <td>{formatPrice(i.total)}</td>
                                    <td>
                                        {i.createdAt?.toLocaleDateString()} -{" "}
                                        {i.createdAt?.toLocaleTimeString(
                                            undefined,
                                            {
                                                hour: "2-digit",
                                                minute: "2-digit",
                                                hour12: false,
                                            },
                                        )}
                                    </td>
                                    <td>
                                        {i.updatedAt?.toLocaleDateString()} -{" "}
                                        {i.updatedAt?.toLocaleTimeString(
                                            undefined,
                                            {
                                                hour: "2-digit",
                                                minute: "2-digit",
                                                hour12: false,
                                            },
                                        )}
                                    </td>
                                </tr>
                            );
                        }))
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Item</th>
                        <th>Amount</th>
                        <th>Invoice Date</th>
                        <th>Paid Date</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<script is:inline>
    lazyLoadCss("/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css");
</script>

<script src="/plugins/datatables/jquery.dataTables.min.js" is:inline></script>
<script src="/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js" is:inline
></script>

<script is:inline>
    $(function () {
        $("#unpaid-invoice-table").DataTable({
            responsive: false,
            lengthChange: false,
            autoWidth: false,
        });
        $("#paid-invoice-table").DataTable({
            responsive: false,
            lengthChange: false,
            autoWidth: false,
        });
    });
</script>
